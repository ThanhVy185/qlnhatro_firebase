<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollContract"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Tiêu đề -->
        <TextView
            android:id="@+id/tvContractTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HĐ PHÒNG 1"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_gravity="center"/>

        <!-- Thông tin hợp đồng -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thông tin hợp đồng"
            android:textStyle="bold"
            android:layout_marginTop="16dp"/>

        <!-- Mã hợp đồng -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Mã hợp đồng"/>
            <TextView
                android:id="@+id/tvContractCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="A12"/>
        </LinearLayout>

        <!-- Tên người thuê -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Tên người thuê"/>
            <TextView
                android:id="@+id/tvTenantName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nguyễn Văn A"/>
        </LinearLayout>

        <!-- CCCD -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="CCCD"/>
            <TextView
                android:id="@+id/tvIdNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0567832345"/>
        </LinearLayout>

        <!-- Ảnh hợp đồng -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hình ảnh hợp đồng"
            android:layout_marginTop="12dp"/>
        <ImageView
            android:id="@+id/ivContractImage"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:background="@color/gray_light"/>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginVertical="16dp"/>

        <!-- Thông tin thanh toán -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thông tin thanh toán"
            android:textStyle="bold"/>

        <!-- Tiền điện -->
        <include layout="@layout/item_fee"
            android:id="@+id/layoutElec"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"/>
        <!-- Tiền nước -->
        <include layout="@layout/item_fee"
            android:id="@+id/layoutWater"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"/>
        <!-- Tiền dịch vụ -->
        <include layout="@layout/item_fee"
            android:id="@+id/layoutService"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"/>
        <!-- Tiền xe -->
        <include layout="@layout/item_fee"
            android:id="@+id/layoutParking"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"/>

        <!-- Tổng cộng -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="TỔNG CỘNG"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/tvTotalFee"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3.600.000₫"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Nút đánh dấu đã thanh toán -->
        <Button
            android:id="@+id/btnMarkPaid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Đánh dấu đã thanh toán"
            android:layout_marginTop="16dp"/>
    </LinearLayout>
</ScrollView>
