<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Spinner chọn phòng -->
        <TextView android:text="Phòng" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <Spinner android:id="@+id/spEditRooms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"/>

        <!-- Spinner chọn người thuê -->
        <TextView android:text="Người thuê" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <Spinner android:id="@+id/spEditTenants"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"/>

        <!-- Giá thuê -->
        <TextView android:text="Giá thuê (VNĐ)" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/etEditRent"
            android:inputType="number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"/>

        <!-- Tiền cọc -->
        <TextView android:text="Tiền cọc (VNĐ)" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/etEditDeposit"
            android:inputType="number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"/>

        <!-- Tiền điện -->
        <TextView android:text="Tiền điện (VNĐ)" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/etEditElectricity"
            android:inputType="number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"/>

        <!-- Tiền nước -->
        <TextView android:text="Tiền nước (VNĐ)" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/etEditWater"
            android:inputType="number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"/>

        <!-- Ngày bắt đầu -->
        <TextView android:text="Ngày bắt đầu" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/etEditStart"
            android:focusable="false"
            android:hint="Chọn ngày"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"/>

        <!-- Ngày kết thúc -->
        <TextView android:text="Ngày kết thúc" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/etEditEnd"
            android:focusable="false"
            android:hint="Chọn ngày"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"/>
    </LinearLayout>
</ScrollView>
