<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Tiêu đề cố định ở trên -->
    <TextView
        android:id="@+id/tvTitleDetailRule"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="NỘI QUY"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:gravity="center"
        android:paddingTop="24dp"
        android:paddingBottom="8dp"
        android:layout_gravity="top" />

    <!-- ScrollView chứa nội dung, cách header 56dp -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="56dp"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Đang tải..."
            android:textSize="14sp"
            android:textColor="@android:color/black"/>
    </ScrollView>

    <!-- ImageButton Chỉnh sửa neo góc dưới|end -->
    <ImageButton
        android:id="@+id/btnEditRules"
        android:layout_width="@dimen/icon_size"
        android:layout_height="@dimen/icon_size"
        android:src="@drawable/ic_edit"
        android:contentDescription="Chỉnh sửa nội quy"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="0dp"
        android:adjustViewBounds="true"
        android:scaleType="centerInside"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"/>

</FrameLayout>
