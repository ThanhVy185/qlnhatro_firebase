<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Chọn phòng -->
        <TextView
            android:text="Chọn phòng"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <Spinner
            android:id="@+id/spnContractRooms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"/>

        <!-- Chọn người thuê -->
        <TextView
            android:text="Chọn người thuê"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <Spinner
            android:id="@+id/spnContractTenants"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"/>

        <!-- Giá thuê -->
        <TextView
            android:text="Giá thuê (VNĐ)"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <EditText
            android:id="@+id/etContractRent"
            android:inputType="number"
            android:hint="e.g. 4000000"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:text="Tiền cọc (VNĐ)"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <EditText
            android:id="@+id/etContractDeposit"
            android:inputType="number"
            android:hint="e.g. 2000000"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"/>

        <!-- Tiền điện -->
        <TextView
            android:text="Tiền điện (VNĐ)"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <EditText
            android:id="@+id/etContractElectricity"
            android:inputType="number"
            android:hint="e.g. 500000"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"/>

        <!-- Tiền nước -->
        <TextView
            android:text="Tiền nước (VNĐ)"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <EditText
            android:id="@+id/etContractWater"
            android:inputType="number"
            android:hint="e.g. 300000"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"/>



        <!-- Ngày bắt đầu -->
        <TextView
            android:text="Ngày bắt đầu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <EditText
            android:id="@+id/etContractStart"
            android:focusable="false"
            android:hint="Chọn ngày"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"/>

        <!-- Ngày kết thúc -->
        <TextView
            android:text="Ngày kết thúc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <EditText
            android:id="@+id/etContractEnd"
            android:focusable="false"
            android:hint="Chọn ngày"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"/>

        <!-- Nút Lưu -->
        <Button
            android:id="@+id/btnSaveContract"
            android:text="Lưu hợp đồng"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#79D57A"/>
    </LinearLayout>
</ScrollView>
