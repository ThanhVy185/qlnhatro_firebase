<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="120dp"
    android:layout_margin="8dp"
    card:cardCornerRadius="@dimen/card_corner"
    card:cardElevation="@dimen/card_elevation"
    card:cardUseCompatPadding="true"
    card:cardBackgroundColor="@android:color/white">

<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:gravity="center"
android:orientation="vertical"
android:padding="12dp">

<ImageView
    android:id="@+id/imgCatIcon"
    android:layout_width="40dp"
    android:layout_height="40dp"
    android:scaleType="centerInside"
    android:contentDescription="@string/title_quanly_noiquy" />

<TextView
    android:id="@+id/tvCatTitle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:gravity="center"
    android:textColor="@android:color/black"
    android:textSize="14sp"
    android:maxLines="2"
    android:breakStrategy="balanced"
    android:includeFontPadding="false" />

</LinearLayout>
    </androidx.cardview.widget.CardView>
