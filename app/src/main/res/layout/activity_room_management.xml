<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Hai nút Phòng / Người thuê -->
    <LinearLayout
        android:id="@+id/tabsLayout"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:orientation="horizontal"
        android:background="#79D57A"
        android:padding="8dp">

        <Button
            android:id="@+id/btnGoRooms"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:backgroundTint="#79D57A"
            android:text="Phòng"
            android:textSize="20dp"
            android:textColor="@android:color/white"
            android:layout_marginTop="15dp"/>


    </LinearLayout>

    <!-- RecyclerView hiển thị grid phòng -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRooms"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/tabsLayout"
        android:layout_above="@+id/fabAddRoom"
        android:padding="8dp"/>

    <!-- Nút + để mở form thêm phòng -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddRoom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="16dp"
        app:srcCompat="@drawable/ic_add"
        android:tint="@android:color/white"/>

</RelativeLayout>