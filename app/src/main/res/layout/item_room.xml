<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:padding="16dp"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <!-- Icon phòng -->
    <ImageView
        android:id="@+id/roomIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="16dp"
        android:src="@drawable/opendoor" />  <!-- Icon mặc định -->

    <!-- Tên phòng -->
    <TextView
        android:id="@+id/tvRoomNuber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Phòng X"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_gravity="center_vertical" />

    <!-- Màu viền (sẽ được thay đổi trong adapter) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardRoom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="8dp"
        app:cardElevation="2dp"
        app:strokeColor="#DDDDDD"
        app:strokeWidth="2dp"
        android:layout_marginTop="8dp">

        <!-- Layout của Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/txtTenPhong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phòng 1"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtGiaPhong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Giá: 500,000 VND"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtTrangThai"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trạng thái: Trống"
                android:textSize="14sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
