<!-- dialog_add_room.xml -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Số phòng -->
        <EditText
            android:id="@+id/etDialogRoomNumber"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Số phòng"
            android:inputType="text"
            android:padding="8dp"/>

        <!-- Tên phòng -->
        <EditText
            android:id="@+id/etDialogRoomName"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Tên phòng"
            android:inputType="text"
            android:layout_marginTop="8dp"
            android:padding="8dp"/>

        <!-- Số lượng tối đa (người) -->
        <EditText
            android:id="@+id/etDialogRoomMax"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Số lượng tối đa (người)"
            android:inputType="number"
            android:layout_marginTop="8dp"
            android:padding="8dp"/>

        <!-- Chọn nội thất -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chọn nội thất:"
            android:textStyle="bold"
            android:layout_marginTop="16dp"/>

        <GridLayout
            android:id="@+id/glInteriors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="4"
            android:alignmentMode="alignMargins"
            android:useDefaultMargins="true"
            android:layout_marginTop="8dp">

            <ImageButton
                android:id="@+id/btnBed"
                android:tag="bed"
                style="@style/Widget.AppCompat.ImageButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/bed"
                android:contentDescription="Giường"
                android:backgroundTint="@color/white"
                android:alpha="0.4"/>

            <ImageButton
                android:id="@+id/btnMaylanh"
                android:tag="air_conditioner"
                style="@style/Widget.AppCompat.ImageButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/air_conditioner"
                android:contentDescription="Máy lạnh"
                android:backgroundTint="@color/white"
                android:alpha="0.4"/>

            <ImageButton
                android:id="@+id/btnMayquat"
                android:tag="fan"
                style="@style/Widget.AppCompat.ImageButton"
                android:layout_width="60dp"
                android:layout_height="64dp"
                android:src="@drawable/fan"
                android:contentDescription="Máy quạt"
                android:backgroundTint="@color/white"
                android:alpha="0.4"/>

            <ImageButton
                android:id="@+id/btnTV"
                android:tag="television"
                style="@style/Widget.AppCompat.ImageButton"
                android:layout_width="60dp"
                android:layout_height="64dp"
                android:src="@drawable/television"
                android:contentDescription="Tivi"
                android:backgroundTint="@color/white"
                android:alpha="0.4"/>

            <ImageButton
                android:id="@+id/btnTuLanh"
                android:tag="fridge"
                style="@style/Widget.AppCompat.ImageButton"
                android:layout_width="60dp"
                android:layout_height="64dp"
                android:src="@drawable/fridge"
                android:contentDescription="Tủ lạnh"
                android:backgroundTint="@color/white"
                android:alpha="0.4"/>

            <ImageButton
                android:id="@+id/btnMaygiat"
                android:tag="maygiat"
                style="@style/Widget.AppCompat.ImageButton"
                android:layout_width="60dp"
                android:layout_height="64dp"
                android:src="@drawable/maygiat"
                android:contentDescription="Máy giặt"
                android:backgroundTint="@color/white"
                android:alpha="0.4"/>

            <ImageButton
                android:id="@+id/btnCooking"
                android:tag="cooking"
                style="@style/Widget.AppCompat.ImageButton"
                android:layout_width="60dp"
                android:layout_height="64dp"
                android:src="@drawable/cooking"
                android:contentDescription="Nấu ăn"
                android:backgroundTint="@color/white"
                android:alpha="0.4"/>

            <ImageButton
                android:id="@+id/btnWifi"
                android:tag="wi_fi_icon"
                style="@style/Widget.AppCompat.ImageButton"
                android:layout_width="60dp"
                android:layout_height="64dp"
                android:src="@drawable/wi_fi_icon"
                android:contentDescription="Wifi"
                android:backgroundTint="@color/white"
                android:alpha="0.4"/>
        </GridLayout>

        <!-- Nút Hủy và Lưu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="16dp">

            <Button
                android:id="@+id/btnDialogCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hủy"
                android:backgroundTint="#79D57A"/>

            <Button
                android:id="@+id/btnDialogSave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lưu"
                android:layout_marginStart="8dp"
                android:backgroundTint="#79D57A"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
