<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- ADMIN -->
    <TextView
        android:id="@+id/tvAdmin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="APP QUẢN LÝ NHÀ TRỌ"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true" />

    <!-- Exit -->
    <Button
        android:id="@+id/btnExit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="EXIT"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:backgroundTint="#E00202"/>

    <!-- 4 Buttons -->
    <GridLayout
        android:id="@+id/gridLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:columnCount="2"
        android:rowCount="2"
        android:alignmentMode="alignMargins"
        android:padding="20dp"
        android:layout_marginTop="50dp">

        <Button
            android:id="@+id/btnQLPhong"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:text="QUẢN LÝ PHÒNG và NGƯỜI THUÊ"
            android:backgroundTint="#00C853"/>

        <Button
            android:id="@+id/btnQLHopDong"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:text="QUẢN LÝ \nHỢP ĐỒNG"
            android:backgroundTint="#00C853"/>

        <Button
            android:id="@+id/btnQLHoaDon"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:text="QUẢN LÝ\nHÓA ĐƠN"
            android:backgroundTint="#00C853"/>

        <Button
            android:id="@+id/btnQLThongBao"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:text="QUẢN LÝ\nTHÔNG BÁO"
            android:backgroundTint="#00C853"/>
    </GridLayout>
</RelativeLayout>
